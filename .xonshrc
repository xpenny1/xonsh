from prompt_toolkit.keys import Keys
from prompt_toolkit.application import run_in_terminal

import json
import pathlib

configPath = "/home/cward/.config/xonsh"


$XONSH_SHOW_TRACEBACK = True
$XONSH_TRACEBACK_LOGFILE = 'error.log'

$PATH.append('~/.local/bin')

#aliases['kak'] = lambda args: execx(f"tmux -c 'kak {args[0]}'")

# XONSH WEBCONFIG START
$XONSH_COLOR_STYLE = 'default'
$PROMPT = '{INTENSE_PURPLE}┬─[{YELLOW}{user}{RESET}@{BLUE}{hostname}{RESET}:{cwd}{INTENSE_PURPLE}]─[{INTENSE_BLUE}{localtime}{INTENSE_PURPLE}]─[{RESET}{INTENSE_PURPLE}{gitstatus}{INTENSE_PURPLE}]\n{INTENSE_PURPLE}╰─>{INTENSE_RED}{prompt_end}{RESET} '
# XONSH WEBCONFIG END


def _multiline(line_number, width):
    return f'{{PURPLE}}{line_number:>{width - 2}}|{{RESET}}'

$MULTILINE_PROMPT = _multiline

execx($(zoxide init xonsh), 'exec', __xonsh__.ctx, filename='zoxide')

$INDENT = "  "

def keybindingsWrapper(command, event):
    def _task():
        execx(command + " || true")
    event.current_buffer.text = ""
    run_in_terminal(_task)
    event.current_buffer.validate_and_handle()

@events.on_ptk_create
def custom_keybindings(bindings, **kw):
    @bindings.add(Keys.ControlL)
    def launch_zoxide(event):
        keybindingsWrapper("zi", event)
    @bindings.add(Keys.ControlJ)
    def launch_lazygit(event):
        keybindingsWrapper("lazygit", event)


@aliases.register
def _l(args):
    ls -lAh @(args)

@aliases.register
def _ll(args):
    ls -lh @(args)

@aliases.register
def _kak(args):
    tmux new -- kak @(args)

@aliases.register
def _toCap(args, stdin=None):
    text = stdin.read() if stdin else ' '.join(args)
    print(text.title())

with open(f"{configPath}/api_DeepSeek.txt") as f:
    $API_DeepSeek = f.read()
